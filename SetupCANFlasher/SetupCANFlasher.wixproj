<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>TrionicCANFlasher</OutputName>
    <!-- self-contained `dotnet publish -r win-x86` folder with libusb-1.0.dll added, see .github/workflows/build.yml -->
    <PublishDir Condition="'$(PublishDir)' == ''">..\TrionicCANFlasher\bin\Release\net10.0\win-x86\publish</PublishDir>
    <_PublishDirFull>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_PublishDirFull>
    <DefineConstants>$(DefineConstants);PublishDir=$(_PublishDirFull.TrimEnd('\/'))</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="disclaimer.rtf" />
  </ItemGroup>
</Project>
