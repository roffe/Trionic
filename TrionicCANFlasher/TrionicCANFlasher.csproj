<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrionicCANFlasher</RootNamespace>
    <AssemblyName>TrionicCANFlasher</AssemblyName>
    <ApplicationIcon>TrionicCanFlasher.ico</ApplicationIcon>
    <Company>MattiasC</Company>
    <Copyright>Copyright © 2025 Dilemma/Mattias Claesson</Copyright>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- ponytail: Windows stays 32-bit, most J2534 and the Lawicel CANUSB drivers only ship x86 DLLs -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="TrionicCanFlasher.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="NLog" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrionicCANLib\TrionicCANLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TrionicCanFlasher.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Libs\canlib32.dll" Link="canlib32.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="$(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')" />
  </ItemGroup>

</Project>
